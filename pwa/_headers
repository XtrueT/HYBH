# H.Y.B.H PWA 安全响应头（CF Pages 原生支持）
# frame-ancestors 只能通过 HTTP 头生效（meta CSP 不支持），故在此声明
/*
  Content-Security-Policy: default-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; manifest-src 'self'; worker-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()

/manifest.webmanifest
  Content-Type: application/manifest+json
